{
  "info": {
    "name": "Library Manager",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "auteurId",
      "value": "1"
    },
    {
      "key": "livreId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/register"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"biblio@lbm.com\",\n  \"password\": \"Biblio@123\",\n  \"tel\": \"20123456\",\n  \"nom\": \"Ben Ali\",\n  \"prenom\": \"Sami\"\n}"
            }
          }
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@lbm.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token || j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login bibliothécaire",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"biblio@lbm.com\",\n  \"password\": \"Biblio@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token || j.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auteurs",
      "item": [
        {
          "name": "Lister",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auteurs"
            }
          }
        },
        {
          "name": "Créer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auteurs"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Hugo\",\n  \"prenom\": \"Victor\",\n  \"nationalite\": \"Française\",\n  \"email\": \"hugo@mail.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('auteurId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Détail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auteurs/{{auteurId}}"
            }
          }
        },
        {
          "name": "Modifier (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auteurs/{{auteurId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Hugo\",\n  \"prenom\": \"Victor M.\",\n  \"nationalite\": \"Française\",\n  \"email\": \"hugo@mail.com\"\n}"
            }
          }
        },
        {
          "name": "Supprimer (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auteurs/{{auteurId}}"
            }
          }
        }
      ]
    },
    {
      "name": "Livres",
      "item": [
        {
          "name": "Lister",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/livres"
            }
          }
        },
        {
          "name": "Créer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/livres"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Les Misérables\",\n  \"isbn\": \"978-2-07-040850-4\",\n  \"categorie\": \"Roman\",\n  \"nbPages\": 1900,\n  \"nbExemplaires\": 4,\n  \"description\": \"Classique\",\n  \"idAuteur\": \"{{auteurId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('livreId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Détail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/livres/{{livreId}}"
            }
          }
        },
        {
          "name": "Modifier (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/livres/{{livreId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Les Misérables\",\n  \"isbn\": \"978-2-07-040850-4\",\n  \"categorie\": \"Roman\",\n  \"nbPages\": 1900,\n  \"nbExemplaires\": 6,\n  \"description\": \"Classique\",\n  \"idAuteur\": \"{{auteurId}}\"\n}"
            }
          }
        },
        {
          "name": "Supprimer (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/livres/{{livreId}}"
            }
          }
        }
      ]
    },
    {
      "name": "Users (ADMIN)",
      "item": [
        {
          "name": "Lister",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/users"
            }
          }
        },
        {
          "name": "Rôles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/roles"
            }
          }
        },
        {
          "name": "Créer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/users"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nouveau@lbm.com\",\n  \"password\": \"Pass@123\",\n  \"tel\": \"99999999\",\n  \"nom\": \"Test\",\n  \"prenom\": \"User\",\n  \"roles\": [\n    \"BIBLIOTHECAIRE\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Modifier",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/users/{{userId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nouveau@lbm.com\",\n  \"tel\": \"99999999\",\n  \"nom\": \"Test\",\n  \"prenom\": \"User\",\n  \"roles\": [\n    \"ADMIN\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Supprimer",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/users/{{userId}}"
            }
          }
        }
      ]
    },
    {
      "name": "Sécurité",
      "item": [
        {
          "name": "Sans token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/auteurs"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Biblio : DELETE auteur → 403 (se connecter en biblio avant)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auteurs/1"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Biblio : GET users → 403 (se connecter en biblio avant)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/users"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}